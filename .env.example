NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this value to client components.
SUPABASE_SERVICE_ROLE_KEY=

# Private article studio. Keep these values server-only; never use NEXT_PUBLIC_.
ADMIN_EDITOR_PASSWORD=
# Generate a random value of at least 32 characters (for example with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# GitHub repository write access, used only by the server-side publishing endpoint.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=main